@page "/"

<PageTitle>FixLink | Find Trusted Local Services</PageTitle>

<div class="home-page">

    <section class="hero-section">
        <div class="hero-content">
            <span class="hero-badge">
                YOUR LOCAL SERVICES DIRECTORY
            </span>

            <h1>
                Find trusted professionals
                <span>near you.</span>
            </h1>

            <p class="hero-description">
                From plumbing and electrical work to cleaning and
                renovations, connect with reliable local service
                providers across South Africa.
            </p>

            <div class="hero-actions">
                <a href="/providers" class="btn-primary">
                    Find a Provider
                </a>

                <a href="/register" class="btn-secondary">
                    Join FixLink
                </a>
            </div>

            <div class="hero-trust">
                <span>✓ Local professionals</span>
                <span>✓ Customer reviews</span>
                <span>✓ Easy to use</span>
            </div>
        </div>

        <div class="hero-card">
            <div class="hero-card-icon">F</div>

            <h3>Need a helping hand?</h3>

            <p>
                Find the right person for the job, all in one place.
            </p>

            <div class="hero-card-divider"></div>

            <div class="hero-card-item">
                <span class="mini-icon">✓</span>
                Browse service providers
            </div>

            <div class="hero-card-item">
                <span class="mini-icon">✓</span>
                Compare customer reviews
            </div>

            <div class="hero-card-item">
                <span class="mini-icon">✓</span>
                Contact providers directly
            </div>
        </div>
    </section>

    <section class="categories-section">
        <div class="section-heading">
            <div>
                <span class="section-eyebrow">WHAT DO YOU NEED?</span>
                <h2>Explore popular services</h2>
                <p>Find the right professional for your next job.</p>
            </div>

            <a href="/providers" class="view-all">
                View all providers →
            </a>
        </div>

        <div class="category-grid">

            <a href="/providers?category=Plumbing"
               class="category-card">
                <span class="category-icon">🔧</span>
                <h3>Plumbing</h3>
                <p>Leaks, pipes and repairs</p>
            </a>

            <a href="/providers?category=Electrical"
               class="category-card">
                <span class="category-icon">⚡</span>
                <h3>Electrical</h3>
                <p>Installations and repairs</p>
            </a>

            <a href="/providers?category=Cleaning"
               class="category-card">
                <span class="category-icon">🧹</span>
                <h3>Cleaning</h3>
                <p>Homes and businesses</p>
            </a>

            <a href="/providers?category=Building"
               class="category-card">
                <span class="category-icon">🏠</span>
                <h3>Building</h3>
                <p>Construction and renovations</p>
            </a>

            <a href="/providers?category=Gardening"
               class="category-card">
                <span class="category-icon">🌿</span>
                <h3>Gardening</h3>
                <p>Garden care and landscaping</p>
            </a>

            <a href="/providers?category=Automotive"
               class="category-card">
                <span class="category-icon">🚗</span>
                <h3>Automotive</h3>
                <p>Vehicle repairs and servicing</p>
            </a>

        </div>
    </section>

    <section class="how-it-works">
        <div class="section-heading">
            <div>
                <span class="section-eyebrow">SIMPLE AND CONVENIENT</span>
                <h2>How FixLink works</h2>
                <p>Finding help doesn't have to be complicated.</p>
            </div>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <span class="step-number">01</span>
                <h3>Find a service</h3>
                <p>
                    Browse service categories and find professionals
                    in your area.
                </p>
            </div>

            <div class="step-card">
                <span class="step-number">02</span>
                <h3>Compare providers</h3>
                <p>
                    Explore business profiles, services and
                    customer reviews.
                </p>
            </div>

            <div class="step-card">
                <span class="step-number">03</span>
                <h3>Get in touch</h3>
                <p>
                    Contact the provider directly to discuss
                    your requirements.
                </p>
            </div>
        </div>
    </section>

</div>