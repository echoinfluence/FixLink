@page "/providers"
@using System.Net.Http.Json
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Find a Provider | FixLink</PageTitle>

<div class="providers-page">

    <section class="providers-heading">
        <span class="section-eyebrow">THE FIXLINK DIRECTORY</span>
        <h1>Find a trusted <span>local professional.</span></h1>
        <p>
            Browse local service providers and find the right
            professional for your next job.
        </p>
    </section>

    <section class="directory-section">

        <div class="directory-toolbar">
            <div>
                <h2>Service providers</h2>
                <p>
                    @if (isLoading)
                    {
                        <span>Loading providers...</span>
                    }
                    else
                    {
                        <span>@filteredProviders.Count provider(s) found</span>
                    }
                </p>
            </div>

            <div class="directory-filters">

                <div class="search-box">
                    <span>⌕</span>
                    <input type="search"
                           placeholder="Search business or location..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
                </div>

                @if (categories.Count > 0)
                {
                    <div class="category-filter">
                        <select @bind="selectedCategory"
                                aria-label="Filter by service category">
                            <option value="">All categories</option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.Name" @key="category.Id">
                                    @category.Name
                                </option>
                            }
                        </select>
                    </div>
                }


                <div class="category-filter">
                    <select @bind="selectedProvince"
                            @bind:after="OnProvinceChanged"
                            aria-label="Filter by province">

                        <option value="">All provinces</option>

                        <option value="Gauteng">Gauteng</option>
                        <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                        <option value="Western Cape">Western Cape</option>
                        <option value="Eastern Cape">Eastern Cape</option>
                        <option value="Free State">Free State</option>
                        <option value="Limpopo">Limpopo</option>
                        <option value="Mpumalanga">Mpumalanga</option>
                        <option value="Northern Cape">Northern Cape</option>
                        <option value="North West">North West</option>

                    </select>
                </div>

                @if (!string.IsNullOrWhiteSpace(selectedProvince))
                {
                    <div class="category-filter">
                        <select @bind="selectedCity"
                                @bind:after="LoadProviders"
                                aria-label="Filter by city"
                                disabled="@isLoading">

                            <option value="">All cities</option>

                            @foreach (var city in availableCities)
                            {
                                <option value="@city">
                                    @city
                                </option>
                            }

                        </select>
                    </div>
                }


            </div>
        </div>

        @if (isLoading)
        {
            <div class="directory-message">
                <div class="loading-spinner"></div>
                <p>Finding local professionals...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="directory-message error-message">
                <h3>We couldn't load the providers</h3>
                <p>@errorMessage</p>
                <button class="retry-button" @onclick="LoadProviders">
                    Try again
                </button>
            </div>
        }
        else if (filteredProviders.Count == 0)
        {
            <div class="directory-message">
                <h3>No providers found</h3>
                <p>Try another business name or location.</p>
            </div>
        }
        else
        {
            <div class="provider-grid">
                @foreach (var provider in filteredProviders)
                {
                    <article class="provider-card" @key="provider.Id">

                        <div class="provider-card-top">
                            <div class="provider-avatar">
                                @GetInitials(provider.BusinessName)
                            </div>

                            @if (provider.IsVerified)
                            {
                                <span class="verified-badge">
                                    ✓ Verified
                                </span>
                            }
                        </div>

                        <div class="provider-card-body">
                            <h3>@provider.BusinessName</h3>

                            <p class="provider-location">
                                <span>⌖</span>
                                @FormatLocation(provider)
                            </p>

                            <p class="provider-description">
                                @(string.IsNullOrWhiteSpace(provider.Description)
                                    ? "Contact this provider to learn more about their services."
                                    : provider.Description)
                            </p>

                            @if (provider.Services.Count > 0)
                            {
                                <div class="provider-services">
                                    @foreach (var service in provider.Services.Take(3))
                                    {
                                        <span class="service-tag" @key="service.Id">
                                            @service.Name
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="provider-card-footer">
                            <a class="contact-button"
                               href="@($"/providers/{provider.Id}")">
                                View provider
                            </a>
                        </div>

                    </article>
                }
            </div>
        }

    </section>
</div>



@code {
    private List<ProviderCard> providers = new();
    private List<CategoryOption> categories = new();

    private string searchTerm = string.Empty;
    private string selectedCategory = string.Empty;

    private string selectedProvince = string.Empty;

    private string selectedCity = string.Empty;
    private List<string> availableCities = new();


    private bool isLoading = true;
    private string? errorMessage;

   

    private List<ProviderCard> filteredProviders =>
     providers
         .Where(p =>
             (
                 string.IsNullOrWhiteSpace(searchTerm) ||
                 p.BusinessName.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase) ||
                 p.City.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase) ||
                 p.Suburb.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase) ||
                 p.Province.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase) ||
                 p.Services.Any(s =>
                     s.Name.Contains(
                         searchTerm,
                         StringComparison.OrdinalIgnoreCase) ||
                     s.CategoryName.Contains(
                         searchTerm,
                         StringComparison.OrdinalIgnoreCase))
             )
             &&
             (
                 string.IsNullOrWhiteSpace(selectedCategory) ||
                 p.Services.Any(s =>
                     string.Equals(
                         s.CategoryName,
                         selectedCategory,
                         StringComparison.OrdinalIgnoreCase))
             )
         )
         .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
    }








    private async Task LoadProviders()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri("https://localhost:7042/");

            var queryParams = new List<string>();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                queryParams.Add(
                    $"search={Uri.EscapeDataString(searchTerm.Trim())}");
            }

            if (!string.IsNullOrWhiteSpace(selectedProvince))
            {
                queryParams.Add(
                    $"province={Uri.EscapeDataString(selectedProvince.Trim())}");
            }

            if (!string.IsNullOrWhiteSpace(selectedCity))
            {
                queryParams.Add(
                    $"city={Uri.EscapeDataString(selectedCity.Trim())}");
            }

            var url = "api/providers";

            if (queryParams.Count > 0)
            {
                url += "?" + string.Join("&", queryParams);
            }

            providers = await client.GetFromJsonAsync<List<ProviderCard>>(
                url) ?? new();

            if (providers.Count == 0)
            {
                errorMessage = "No providers matched your search.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the API. Make sure FixLink.Api is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage =
                "The API returned provider data that the page could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }




    private async Task OnProvinceChanged()
    {
        selectedCity = string.Empty;
        availableCities.Clear();

        if (string.IsNullOrWhiteSpace(selectedProvince))
        {
            await LoadProviders();
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri("https://localhost:7042/");

            var url =
                $"api/providers?province={Uri.EscapeDataString(selectedProvince.Trim())}";

            var provinceProviders =
                await client.GetFromJsonAsync<List<ProviderCard>>(url)
                ?? new();

            availableCities = provinceProviders
                .Select(p => p.City)
                .Where(city => !string.IsNullOrWhiteSpace(city))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(city => city)
                .ToList();
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the API. Make sure FixLink.Api is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage =
                "The API returned provider data that the page could not read.";
        }

        await LoadProviders();
    }





    public class CategoryOption
    {
        public Guid Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }
    }



    private static string GetInitials(string? businessName)
    {
        if (string.IsNullOrWhiteSpace(businessName))
            return "F";

        return string.Join("",
            businessName.Split(' ',
                StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(word => char.ToUpperInvariant(word[0])));
    }

    private static string FormatLocation(ProviderCard provider)
    {
        var parts = new[] { provider.Suburb, provider.City }
            .Where(part => !string.IsNullOrWhiteSpace(part));

        var location = string.Join(", ", parts);

        return string.IsNullOrWhiteSpace(location)
            ? provider.Province
            : location;
    }

    public class ProviderCard
    {
        public Guid Id { get; set; }
        public string BusinessName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string Suburb { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Province { get; set; } = string.Empty;
        public bool IsVerified { get; set; }
        public List<ServiceCard> Services { get; set; } = new();
    }

    public class ServiceCard
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
    }
}