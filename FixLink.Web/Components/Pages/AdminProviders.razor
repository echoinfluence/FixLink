    private HttpClient CreateAuthenticatedClient()
    {
        var client = HttpClientFactory.CreateClient();

        client.BaseAddress = new Uri("https://localhost:7042/");

        client.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue(
                "Bearer",
                AuthSession.Token);

        return client;
    }

    private async Task<bool> HandleAuthErrors(
        HttpResponseMessage response)
    {
        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            errorMessage =
                "Your session has expired. Please log in again.";

            showLoginLink = true;
            return false;
        }

        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            errorMessage =
                "Your account does not have Admin permission.";

            return false;
        }

        return true;
    }

    private static string GetStatusClass(bool isEnabled)
    {
        return isEnabled
            ? "provider-status-active"
            : "provider-status-inactive";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await AuthSession.RestoreTokenAsync();

            if (AuthSession.IsAuthenticated)
            {
                await LoadProviders();
            }

            StateHasChanged();
        }
        catch (JSException)
        {
            errorMessage =
                "Unable to restore your session. Please log in again.";

            showLoginLink = true;
            StateHasChanged();
        }
    }

