@page "/admin/providers"

@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using FixLink.Web.Services
@using Microsoft.JSInterop

@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession
@inject IJSRuntime JS


<PageTitle>Manage Providers | FixLink Admin</PageTitle>

<div class="admin-business-hours-page">

    <div class="admin-reviews-header">
        <div>
            <span class="admin-eyebrow">FIXLINK ADMIN</span>
            <h1>Manage providers</h1>
            <p>View and manage all service providers on FixLink.</p>
        </div>
    </div>

    @if (!AuthSession.IsAuthenticated)
    {
        <div class="admin-notice admin-notice-warning">
            <strong>Login required</strong>
            <p>Please log in with your admin account to manage providers.</p>
            <a href="/login">Go to login →</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="admin-notice admin-notice-error">
                <strong>Unable to load providers</strong>
                <p>@errorMessage</p>

                @if (showLoginLink)
                {
                    <a href="/login">Log in again →</a>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="admin-notice">
                <strong>@successMessage</strong>
            </div>
        }

        <div class="admin-review-card">

            <div class="providers-list-header">
                <div>
                    <h2>All providers</h2>
                    <p>
                        @providers.Count provider(s) found
                    </p>
                </div>

                @* <button class="business-hours-load-button"
                        @onclick="LoadProviders"
                        disabled="@isLoading">
                    @(isLoading ? "Loading..." : "Refresh")
                </button> *@

                <div class="provider-admin-actions">
                    <button class="business-hours-load-button"
                            @onclick="ToggleCreateForm">
                        @(showCreateForm ? "Cancel" : "+ Add provider")
                    </button>

                    <button class="business-hours-load-button"
                            @onclick="LoadProviders"
                            disabled="@isLoading">
                        @(isLoading ? "Loading..." : "Refresh")
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <p>Loading providers...</p>
            }
            else if (providers.Count == 0 &&
                     string.IsNullOrWhiteSpace(errorMessage))
            {
                <p>No providers were found.</p>
            }
            else if (providers.Count > 0)
            {

                @if (showCreateForm)
                {
                    <div class="provider-create-form">
                        <h2>@(isEditMode ? "Edit provider" : "Add a new provider")</h2>

                        <p>
                            @(isEditMode
                                ? "Update the business details, services and status."
                                : "Enter the business details and select its services.")
                        </p>

                        <div class="provider-form-grid">
                            <label>
                                Business name *
                                <input @bind="newProvider.BusinessName"
                                       maxlength="200"
                                       placeholder="e.g. FixLink Plumbing" />
                            </label>

                            <label>
                                Phone number *
                                <input @bind="newProvider.PhoneNumber"
                                       maxlength="30"
                                       placeholder="Business contact number" />
                            </label>

                            <label>
                                WhatsApp number
                                <input @bind="newProvider.WhatsAppNumber"
                                       maxlength="30" />
                            </label>

                            <label>
                                Email
                                <input type="email"
                                       @bind="newProvider.Email"
                                       maxlength="320" />
                            </label>

                            <label>
                                Website
                                <input type="url"
                                       @bind="newProvider.Website"
                                       maxlength="500"
                                       placeholder="https://" />
                            </label>

                            <label>
                                Years in business
                                <input type="number"
                                       @bind="yearsInBusinessText"
                                       min="0"
                                       max="200" />
                            </label>

                            <label class="provider-form-full">
                                Description *
                                <textarea @bind="newProvider.Description"
                                          maxlength="4000"
                                          rows="4"
                                          placeholder="Describe the business and its services."></textarea>
                            </label>

                            <label>
                                Address line 1 *
                                <input @bind="newProvider.AddressLine1"
                                       maxlength="250" />
                            </label>

                            <label>
                                Address line 2
                                <input @bind="newProvider.AddressLine2"
                                       maxlength="250" />
                            </label>

                            <label>
                                Suburb *
                                <input @bind="newProvider.Suburb"
                                       maxlength="100" />
                            </label>

                            <label>
                                City *
                                <input @bind="newProvider.City"
                                       maxlength="100" />
                            </label>

                            <label>
                                Province *
                                <input @bind="newProvider.Province"
                                       maxlength="100" />
                            </label>

                            <label>
                                Postal code *
                                <input @bind="newProvider.PostalCode"
                                       maxlength="20" />
                            </label>

                            <label>
                                Latitude
                                <input type="number"
                                       step="any"
                                       @bind="latitudeText"
                                       placeholder="Optional" />
                            </label>

                            <label>
                                Longitude
                                <input type="number"
                                       step="any"
                                       @bind="longitudeText"
                                       placeholder="Optional" />
                            </label>
                        </div>

                        <div class="provider-form-option">
                            <input id="newProviderVerified"
                                   type="checkbox"
                                   @bind="newProvider.IsVerified" />

                            <label for="newProviderVerified">
                                Mark this provider as verified
                            </label>
                        </div>

                        @* placeholder  *@
                        @if (isEditMode)
                        {
                            <div class="provider-form-option">
                                <input id="providerActive"
                                       type="checkbox"
                                       @bind="newProvider.IsActive" />

                                <label for="providerActive">Provider is active</label>
                            </div>

                            <div class="provider-form-option">
                                <input id="providerPublished"
                                       type="checkbox"
                                       @bind="newProvider.IsPublished" />

                                <label for="providerPublished">Provider is published</label>
                            </div>
                        }




                        <div class="provider-service-picker">
                            <h3>Services *</h3>
                            <p>Select at least one service for this provider.</p>

                            @if (isLoadingServices)
                            {
                                <p>Loading services...</p>
                            }
                            else if (serviceOptions.Count == 0)
                            {
                                <p>No services are available.</p>
                            }
                            else
                            {
                                @foreach (var group in serviceOptions
                                    .GroupBy(x => new { x.CategoryId, x.CategoryName }))
                                {
                                    <div class="provider-service-category"
                                         @key="group.Key.CategoryId">

                                        <h4>@group.Key.CategoryName</h4>

                                        <div class="provider-service-options">
                                            @foreach (var service in group)
                                            {
                                                <label class="provider-service-option"
                                                       @key="service.Id">

                                                    <input type="checkbox"
                                                           @bind="service.IsSelected" />

                                                    <span>@service.Name</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(createErrorMessage))
                        {
                            <div class="admin-notice admin-notice-error">
                                <strong>Could not create provider</strong>
                                <p>@createErrorMessage</p>
                            </div>
                        }

                        <div class="provider-admin-actions">
                            <button class="business-hours-load-button"
                                    @onclick="SaveProvider"
                                    disabled="@isCreating">

                                @(isCreating
                                    ? "Saving..."
                                    : isEditMode
                                        ? "Save changes"
                                        : "Create provider")
                            </button>

                            @if (isEditMode)
                            {
                                <button class="business-hours-load-button"
                                        @onclick="CancelEdit"
                                        disabled="@isCreating">
                                    Cancel
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="providers-admin-list">

                    @foreach (var provider in providers)
                    {
                        <div class="provider-admin-item"
                             @key="provider.Id">

                            <div class="provider-admin-details">
                                <h3>@provider.BusinessName</h3>

                                <p>
                                    @if (!string.IsNullOrWhiteSpace(provider.City))
                                    {
                                        @provider.City
                                    }

                                    @if (!string.IsNullOrWhiteSpace(provider.Province))
                                    {
                                        @($" , {provider.Province}")
                                    }
                                </p>

                                <div class="provider-admin-statuses">
                                    <span class="@GetStatusClass(provider.IsActive)">
                                        @(provider.IsActive ? "Active" : "Inactive")
                                    </span>

                                    <span class="@GetStatusClass(provider.IsPublished)">
                                        @(provider.IsPublished ? "Published" : "Unpublished")
                                    </span>

                                    @if (provider.IsVerified)
                                    {
                                        <span class="provider-status-verified">
                                            Verified
                                        </span>
                                    }
                                </div>

                                <p class="provider-admin-id">
                                    ID: @provider.Id
                                </p>
                            </div>

                            <div class="provider-admin-actions">
                                <button class="business-hours-load-button"
                                        @onclick="() => EditProvider(provider.Id)">
                                    Edit provider
                                </button>

                                @if (provider.IsActive)
                                {
                                    <button class="business-hours-load-button provider-deactivate-button"
                                            @onclick="() => DeactivateProvider(provider.Id, provider.BusinessName)"
                                            disabled="@(deactivatingProviderId == provider.Id)">
                                        @(deactivatingProviderId == provider.Id
                                            ? "Deactivating..."
                                            : "Deactivate")
                                    </button>
                                }
                            </div>

                        </div>
                    }

                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProviderOption> providers = new();

    private bool showCreateForm;
    private bool isCreating;
    private bool isLoadingServices;

    private string? createErrorMessage;

    private Guid? deactivatingProviderId;

    private string yearsInBusinessText = string.Empty;
    private string latitudeText = string.Empty;
    private string longitudeText = string.Empty;

    private CreateProviderInput newProvider = new();

    private List<ServiceOption> serviceOptions = new();

    private bool isLoading;
    private bool showLoginLink;

    private string? errorMessage;
    private string? successMessage;

    private bool isEditMode;
    private Guid? editingProviderId;

    private async Task LoadProviders()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        showLoginLink = false;

        try
        {
            var client = CreateAuthenticatedClient();

            using var response = await client.GetAsync(
                "api/providers/admin");

            if (!await HandleAuthErrors(response))
                return;

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    $"The API returned {(int)response.StatusCode}.";

                return;
            }

            providers = await response.Content
                .ReadFromJsonAsync<List<ProviderOption>>() ?? new();
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the API. Make sure FixLink.Api is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage =
                "The API returned provider data that the page could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadServices()
    {
        isLoadingServices = true;
        createErrorMessage = null;

        try
        {
            var client = CreateAuthenticatedClient();

            using var response = await client.GetAsync("api/services");

            if (!response.IsSuccessStatusCode)
            {
                createErrorMessage =
                    $"Could not load services. API returned {(int)response.StatusCode}.";
                return;
            }

            serviceOptions = await response.Content
                .ReadFromJsonAsync<List<ServiceOption>>() ?? new();
        }
        catch (HttpRequestException)
        {
            createErrorMessage =
                "Could not connect to the API while loading services.";
        }
        catch (System.Text.Json.JsonException)
        {
            createErrorMessage =
                "The API returned service data that could not be read.";
        }
        finally
        {
            isLoadingServices = false;
            StateHasChanged();
        }
    }

    private async Task CreateProvider()
    {
        createErrorMessage = null;
        errorMessage = null;
        showLoginLink = false;

        var missingFields = new List<string>();

        if (string.IsNullOrWhiteSpace(newProvider.BusinessName))
            missingFields.Add("Business name");

        if (string.IsNullOrWhiteSpace(newProvider.Description))
            missingFields.Add("Description");

        if (string.IsNullOrWhiteSpace(newProvider.PhoneNumber))
            missingFields.Add("Phone number");

        if (string.IsNullOrWhiteSpace(newProvider.AddressLine1))
            missingFields.Add("Address line 1");

        if (string.IsNullOrWhiteSpace(newProvider.Suburb))
            missingFields.Add("Suburb");

        if (string.IsNullOrWhiteSpace(newProvider.City))
            missingFields.Add("City");

        if (string.IsNullOrWhiteSpace(newProvider.Province))
            missingFields.Add("Province");

        if (string.IsNullOrWhiteSpace(newProvider.PostalCode))
            missingFields.Add("Postal code");

        if (missingFields.Count > 0)
        {
            createErrorMessage =
                "Please complete: " + string.Join(", ", missingFields) + ".";

            return;
        }

        var selectedServiceIds = serviceOptions
            .Where(x => x.IsSelected)
            .Select(x => x.Id)
            .ToList();

        if (selectedServiceIds.Count == 0)
        {
            createErrorMessage =
                "Please select at least one service.";
            return;
        }

        int? years = null;

        if (!string.IsNullOrWhiteSpace(yearsInBusinessText))
        {
            if (!int.TryParse(yearsInBusinessText, out var parsedYears) ||
                parsedYears < 0 || parsedYears > 200)
            {
                createErrorMessage =
                    "Years in business must be between 0 and 200.";
                return;
            }

            years = parsedYears;
        }

        double? latitude = null;
        double? longitude = null;

        if (!string.IsNullOrWhiteSpace(latitudeText))
        {
            if (!double.TryParse(
                    latitudeText,
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var parsedLatitude) ||
                parsedLatitude < -90 || parsedLatitude > 90)
            {
                createErrorMessage =
                    "Latitude must be between -90 and 90.";
                return;
            }

            latitude = parsedLatitude;
        }

        if (!string.IsNullOrWhiteSpace(longitudeText))
        {
            if (!double.TryParse(
                    longitudeText,
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var parsedLongitude) ||
                parsedLongitude < -180 || parsedLongitude > 180)
            {
                createErrorMessage =
                    "Longitude must be between -180 and 180.";
                return;
            }

            longitude = parsedLongitude;
        }

        if (latitude.HasValue != longitude.HasValue)
        {
            createErrorMessage =
                "Enter both latitude and longitude, or leave both blank.";
            return;
        }

        isCreating = true;

        try
        {
            var client = CreateAuthenticatedClient();

            var request = new CreateProviderRequest
            {
                BusinessName = newProvider.BusinessName.Trim(),
                Description = newProvider.Description.Trim(),
                PhoneNumber = newProvider.PhoneNumber.Trim(),
                WhatsAppNumber = EmptyToNull(newProvider.WhatsAppNumber),
                Email = EmptyToNull(newProvider.Email),
                Website = EmptyToNull(newProvider.Website),

                AddressLine1 = newProvider.AddressLine1.Trim(),
                AddressLine2 = EmptyToNull(newProvider.AddressLine2),
                Suburb = newProvider.Suburb.Trim(),
                City = newProvider.City.Trim(),
                Province = newProvider.Province.Trim(),
                PostalCode = newProvider.PostalCode.Trim(),

                Latitude = latitude,
                Longitude = longitude,
                YearsInBusiness = years,
                IsVerified = newProvider.IsVerified,
                ServiceIds = selectedServiceIds
            };

            using var response = await client.PostAsJsonAsync(
                "api/providers",
                request);

            if (!await HandleAuthErrors(response))
            {
                createErrorMessage = errorMessage;
                errorMessage = null;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();

                createErrorMessage =
                    $"The API returned {(int)response.StatusCode}: {body}";
                return;
            }

            newProvider = new CreateProviderInput();
            yearsInBusinessText = string.Empty;
            latitudeText = string.Empty;
            longitudeText = string.Empty;

            foreach (var service in serviceOptions)
            {
                service.IsSelected = false;
            }

            showCreateForm = false;
            successMessage = "Provider created successfully.";

            await LoadProviders();
        }
        catch (HttpRequestException)
        {
            createErrorMessage =
                "Could not connect to the API. Make sure FixLink.Api is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            createErrorMessage =
                "The API returned data that could not be read.";
        }
        finally
        {
            isCreating = false;
        }
    }





    private async Task DeactivateProvider(Guid id, string businessName)
    {
        errorMessage = null;
        createErrorMessage = null;
        successMessage = null;
        showLoginLink = false;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to deactivate {businessName}? " +
            "It will no longer appear in public provider searches.");

        if (!confirmed)
            return;

        deactivatingProviderId = id;

        try
        {
            var client = CreateAuthenticatedClient();

            using var response = await client.DeleteAsync(
                $"api/providers/{id}");

            if (!await HandleAuthErrors(response))
                return;

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();

                errorMessage =
                    $"Could not deactivate provider. API returned " +
                    $"{(int)response.StatusCode}: {body}";

                return;
            }

            await LoadProviders();

            if (string.IsNullOrWhiteSpace(errorMessage))
            {
                successMessage =
                    $"{businessName} was deactivated successfully.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not connect to the API.";
        }
        catch (JSException)
        {
            errorMessage = "Could not display the confirmation dialog.";
        }
        finally
        {
            deactivatingProviderId = null;
        }
    }









    private async Task EditProvider(Guid id)
    {
        errorMessage = null;
        createErrorMessage = null;
        successMessage = null;
        showLoginLink = false;

        // Load services before selecting the provider's existing services.
        if (serviceOptions.Count == 0)
        {
            await LoadServices();
        }

        if (serviceOptions.Count == 0)
        {
            errorMessage = createErrorMessage
                ?? "Could not load the available services.";

            showCreateForm = true;
            return;
        }

        try
        {
            var client = CreateAuthenticatedClient();

            using var response = await client.GetAsync(
                "api/providers/admin");

            if (!await HandleAuthErrors(response))
                return;

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    $"Could not load providers. API returned {(int)response.StatusCode}.";
                return;
            }

            var allProviders = await response.Content
                .ReadFromJsonAsync<List<ProviderOption>>() ?? new();

            var provider = allProviders.FirstOrDefault(x => x.Id == id);

            if (provider is null)
            {
                errorMessage = "The selected provider could not be found.";
                return;
            }

            newProvider = new CreateProviderInput
            {
                BusinessName = provider.BusinessName,
                Description = provider.Description,
                PhoneNumber = provider.PhoneNumber,
                WhatsAppNumber = provider.WhatsAppNumber,
                Email = provider.Email,
                Website = provider.Website,

                AddressLine1 = provider.AddressLine1,
                AddressLine2 = provider.AddressLine2,
                Suburb = provider.Suburb,
                City = provider.City,
                Province = provider.Province,
                PostalCode = provider.PostalCode,

                IsVerified = provider.IsVerified,
                IsActive = provider.IsActive,
                IsPublished = provider.IsPublished
            };

            yearsInBusinessText =
                provider.YearsInBusiness?.ToString() ?? string.Empty;

            latitudeText = provider.Latitude?.ToString(
                System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

            longitudeText = provider.Longitude?.ToString(
                System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

            foreach (var service in serviceOptions)
            {
                service.IsSelected =
                    provider.Services.Any(x => x.Id == service.Id);
            }

            editingProviderId = id;
            isEditMode = true;
            showCreateForm = true;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not connect to the API.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned provider data that could not be read.";
        }
    }



    private async Task SaveProvider()
    {
        if (isEditMode)
        {
            await UpdateProvider();
        }
        else
        {
            await CreateProvider();
        }
    }


    private async Task UpdateProvider()
    {
        createErrorMessage = null;
        errorMessage = null;
        showLoginLink = false;

        if (!editingProviderId.HasValue)
        {
            createErrorMessage = "No provider is selected for editing.";
            return;
        }

        var selectedServiceIds = serviceOptions
            .Where(x => x.IsSelected)
            .Select(x => x.Id)
            .ToList();

        if (selectedServiceIds.Count == 0)
        {
            createErrorMessage = "Select at least one service.";
            return;
        }

        if (!ValidateProviderFields())
            return;

        if (!TryGetOptionalValues(
                out var years,
                out var latitude,
                out var longitude))
            return;

        isCreating = true;

        try
        {
            var request = new UpdateProviderRequest
            {
                BusinessName = newProvider.BusinessName.Trim(),
                Description = newProvider.Description.Trim(),
                PhoneNumber = newProvider.PhoneNumber.Trim(),
                WhatsAppNumber = EmptyToNull(newProvider.WhatsAppNumber),
                Email = EmptyToNull(newProvider.Email),
                Website = EmptyToNull(newProvider.Website),

                AddressLine1 = newProvider.AddressLine1.Trim(),
                AddressLine2 = EmptyToNull(newProvider.AddressLine2),
                Suburb = newProvider.Suburb.Trim(),
                City = newProvider.City.Trim(),
                Province = newProvider.Province.Trim(),
                PostalCode = newProvider.PostalCode.Trim(),

                Latitude = latitude,
                Longitude = longitude,
                YearsInBusiness = years,

                IsVerified = newProvider.IsVerified,
                IsPublished = newProvider.IsPublished,
                IsActive = newProvider.IsActive,

                ServiceIds = selectedServiceIds
            };

            var client = CreateAuthenticatedClient();

            using var response = await client.PutAsJsonAsync(
                $"api/providers/{editingProviderId}",
                request);

            if (!await HandleAuthErrors(response))
            {
                createErrorMessage = errorMessage;
                errorMessage = null;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();

                createErrorMessage =
                    $"Could not update provider. API returned {(int)response.StatusCode}: {body}";
                return;
            }

            showCreateForm = false;
            isEditMode = false;
            editingProviderId = null;

            successMessage = "Provider updated successfully.";

            await LoadProviders();
        }
        catch (HttpRequestException)
        {
            createErrorMessage = "Could not connect to the API.";
        }
        catch (System.Text.Json.JsonException)
        {
            createErrorMessage = "The API returned data that could not be read.";
        }
        finally
        {
            isCreating = false;
        }
    }






    private bool ValidateProviderFields()
    {
        var missing = new List<string>();

        if (string.IsNullOrWhiteSpace(newProvider.BusinessName))
            missing.Add("Business name");

        if (string.IsNullOrWhiteSpace(newProvider.Description))
            missing.Add("Description");

        if (string.IsNullOrWhiteSpace(newProvider.PhoneNumber))
            missing.Add("Phone number");

        if (string.IsNullOrWhiteSpace(newProvider.AddressLine1))
            missing.Add("Address line 1");

        if (string.IsNullOrWhiteSpace(newProvider.Suburb))
            missing.Add("Suburb");

        if (string.IsNullOrWhiteSpace(newProvider.City))
            missing.Add("City");

        if (string.IsNullOrWhiteSpace(newProvider.Province))
            missing.Add("Province");

        if (string.IsNullOrWhiteSpace(newProvider.PostalCode))
            missing.Add("Postal code");

        if (missing.Count > 0)
        {
            createErrorMessage =
                "Please complete: " + string.Join(", ", missing) + ".";

            return false;
        }

        return true;
    }

    private bool TryGetOptionalValues(
        out int? years,
        out double? latitude,
        out double? longitude)
    {
        years = null;
        latitude = null;
        longitude = null;

        if (!string.IsNullOrWhiteSpace(yearsInBusinessText))
        {
            if (!int.TryParse(yearsInBusinessText, out var parsedYears) ||
                parsedYears < 0 || parsedYears > 200)
            {
                createErrorMessage =
                    "Years in business must be between 0 and 200.";
                return false;
            }

            years = parsedYears;
        }

        if (!string.IsNullOrWhiteSpace(latitudeText))
        {
            if (!double.TryParse(
                    latitudeText,
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var parsedLatitude) ||
                parsedLatitude < -90 || parsedLatitude > 90)
            {
                createErrorMessage = "Enter a valid latitude between -90 and 90.";
                return false;
            }

            latitude = parsedLatitude;
        }

        if (!string.IsNullOrWhiteSpace(longitudeText))
        {
            if (!double.TryParse(
                    longitudeText,
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var parsedLongitude) ||
                parsedLongitude < -180 || parsedLongitude > 180)
            {
                createErrorMessage = "Enter a valid longitude between -180 and 180.";
                return false;
            }

            longitude = parsedLongitude;
        }

        if (latitude.HasValue != longitude.HasValue)
        {
            createErrorMessage =
                "Enter both coordinates, or leave both blank.";
            return false;
        }

        return true;
    }







